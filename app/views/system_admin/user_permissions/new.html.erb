<% content_for :title, "追加権限を付与" %>

<% if @user_permission.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @user_permission.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:system_admin, @user_permission] do |form| %>
  <div class="mb-3">
    <%= form.label :user_email, "ユーザーのメールアドレス", class: "form-label" %>
    <%= form.email_field :user_email, class: "form-control", required: true, autocomplete: "email" %>
  </div>

  <div class="mb-3">
    <%= form.label :permission_type, "追加権限", class: "form-label" %>
    <%= form.select :permission_type,
          options_for_select(@permission_options, @user_permission.permission_type),
          { include_blank: "選択してください" },
          class: "form-select",
          required: true %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit "付与する", class: "btn btn-primary" %>
    <%= link_to "戻る", system_admin_user_permissions_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
