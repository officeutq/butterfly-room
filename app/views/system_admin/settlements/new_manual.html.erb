<h1>手動精算（system_admin限定）</h1>

<div class="alert alert-secondary" role="alert">
  テスト・例外確認用の手動精算です。JST固定、対象期間は「開始日時を含む / 終了日時を含まない」で集計します。<br>
  月次精算の繰越はこの画面では自動適用しません。
</div>

<%= form_with scope: :manual_settlement,
      url: preview_manual_system_admin_settlements_path,
      method: :post,
      data: { turbo: false } do |f| %>
  <% if @form.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @form.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :store_id, "対象店舗", class: "form-label" %>
    <%= f.select :store_id,
          Store.order(id: :desc).map { |s| [s.name, s.id] },
          { include_blank: "選択してください" },
          class: "form-select",
          required: true %>
  </div>

  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :period_from, "対象期間 開始（JST）", class: "form-label" %>
      <%= f.datetime_field :period_from, class: "form-control", required: true %>
      <div class="form-text">開始日時は集計に含めます</div>
    </div>

    <div class="col-md-6">
      <%= f.label :period_to, "対象期間 終了（JST）", class: "form-label" %>
      <%= f.datetime_field :period_to, class: "form-control", required: true %>
      <div class="form-text">終了日時は集計に含めません</div>
    </div>
  </div>

  <div class="mt-3 d-flex gap-2">
    <%= f.submit "プレビュー", class: "btn btn-primary" %>
    <%= link_to "ダッシュボードへ戻る", dashboard_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<% if @preview.present? %>
  <hr class="my-4">

  <h2 class="h5 mb-3">プレビュー</h2>

  <table class="table table-sm">
    <tbody>
      <tr>
        <th style="width: 220px;">対象期間（JST）</th>
        <td>
          <%= l(@preview[:period_from].in_time_zone("Asia/Tokyo")) %>
          〜
          <%= l(@preview[:period_to].in_time_zone("Asia/Tokyo")) %>
          （終了日時は集計に含めません）
        </td>
      </tr>
      <tr>
        <th>売上総額</th>
        <td><%= @preview[:gross_yen] %></td>
      </tr>
      <tr>
        <th>店舗取り分（売上総額の70%・小数切り捨て）</th>
        <td><%= @preview[:store_share_yen] %></td>
      </tr>
      <tr>
        <th>運営手数料</th>
        <td><%= @preview[:platform_fee_yen] %></td>
      </tr>
    </tbody>
  </table>

  <div class="alert alert-warning" role="alert">
    この画面の「確定して作成」は、プレビューに表示された売上総額・店舗取り分・運営手数料で、
    精算データを確定済みとして作成します。支払、残高表示、繰越の適用・相殺は行いません。
  </div>

  <%= form_with scope: :manual_settlement,
        url: create_manual_system_admin_settlements_path,
        method: :post,
        data: { turbo: false } do |f| %>
    <%= f.hidden_field :store_id, value: @form.store_id %>
    <%= f.hidden_field :period_from, value: @form.period_from %>
    <%= f.hidden_field :period_to, value: @form.period_to %>

    <div class="d-flex gap-2">
      <%= f.submit "確定して作成", class: "btn btn-danger", data: { turbo_confirm: "この内容で精算を確定します。よろしいですか？" } %>
      <%= link_to "キャンセル", dashboard_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
<% end %>
