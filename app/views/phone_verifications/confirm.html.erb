<% content_for :title, "認証コード入力" %>

<%= render "phone_verifications/messages" %>
<p><strong><%= format_phone_number_for_display(@phone_number) %></strong> 宛のSMSに記載された6桁の認証コードを入力してください。</p>
<p class="small text-body-secondary">コードの有効期限は5分です。閉じても登録番号は変わらず、再度開くとコード入力を再開できます。</p>

<%= form_with url: verify_phone_verification_path, method: :post do %>
  <div class="mb-3">
    <%= label_tag :otp_code, "認証コード", class: "form-label" %>
    <%= text_field_tag :otp_code, nil, class: "form-control", inputmode: "numeric", autocomplete: "one-time-code",
          pattern: "[0-9]{6}", maxlength: 6, placeholder: "6桁の認証コード", required: true %>
  </div>
  <div class="d-flex gap-2 flex-wrap mb-3">
    <%= submit_tag "認証して登録", class: "btn btn-primary", data: { turbo_submits_with: "認証中…" } %>
    <%= render "phone_verifications/close" %>
  </div>
<% end %>
<div class="d-flex gap-2 flex-wrap">
  <%= button_to "認証コードを再送", phone_verification_path, method: :post,
        params: { phone_number: @phone_number }, class: "btn btn-outline-primary",
        data: { turbo_submits_with: "送信中…" } %>
  <%= link_to "電話番号を入力し直す", phone_verification_path(edit: "1"), class: "btn btn-outline-secondary" %>
</div>
<p class="form-text">再送は前回の送信から60秒後にできます。</p>
