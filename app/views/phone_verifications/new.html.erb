<% content_for :title, "電話番号認証" %>

<%= render "phone_verifications/messages" %>
<% if @user.phone_verified? %>
  <p>現在の認証済み電話番号：<strong><%= format_phone_number_for_display(@user.phone_number) %></strong></p>
  <p class="small text-body-secondary">新しい電話番号の認証が完了するまで、登録済みの番号は変わりません。</p>
<% else %>
  <p>電話番号はまだ認証されていません。認証すると電話番号でもログインできるようになります。</p>
<% end %>
<p class="small text-body-secondary">認証・登録はこの画面で確定します。編集中のプロフィールはそのまま残ります。</p>

<%= form_with url: phone_verification_path, method: :post do %>
  <div class="mb-3">
    <%= label_tag :phone_number, "電話番号", class: "form-label" %>
    <%= telephone_field_tag :phone_number, format_phone_number_for_display(@phone_number),
          class: "form-control", placeholder: "090-1234-5678", autocomplete: "tel", required: true %>
    <div class="form-text">入力した電話番号宛に認証コードを送信します。</div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <%= submit_tag "認証コードを送信", class: "btn btn-primary", data: { turbo_submits_with: "送信中…" } %>
    <%= render "phone_verifications/close" %>
  </div>
<% end %>
