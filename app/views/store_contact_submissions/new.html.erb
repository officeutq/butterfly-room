<% content_for :title, "店舗向けお問い合わせ" %>

<h1 class="container mt-4">店舗向けお問い合わせ</h1>

<div class="container mt-3" style="max-width: 720px;">
  <p class="text-secondary mb-4">
    Butterflyveの導入をご検討中の店舗様は、こちらからお気軽にお問い合わせください。
  </p>

  <% if @store_contact_submission.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @store_contact_submission.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <%= form_with model: @store_contact_submission,
            url: @store_contact_form_path,
            scope: :store_contact_submission,
            html: { class: "store-contact-submission-form" } do |f| %>
        <div class="mb-3">
          <%= f.label :name, class: "form-label" do %>
            お名前<%= tag.span "必須",
                  class: "badge rounded-pill text-bg-danger store-contact-submission-field-badge" %>
          <% end %>
          <%= f.text_field :name,
                class: "form-control",
                maxlength: StoreContactSubmission::NAME_MAX_LENGTH,
                placeholder: "例: 山田 太郎",
                required: true,
                autocomplete: "name" %>
        </div>

        <div class="mb-3">
          <%= f.label :store_name, class: "form-label" do %>
            店舗名<%= tag.span "必須",
                  class: "badge rounded-pill text-bg-danger store-contact-submission-field-badge" %>
          <% end %>
          <%= f.text_field :store_name,
                class: "form-control",
                maxlength: StoreContactSubmission::STORE_NAME_MAX_LENGTH,
                placeholder: "例: Butterflyve Bar 新宿店",
                required: true,
                autocomplete: "organization" %>
        </div>

        <div class="mb-3">
          <%= f.label :business_type, class: "form-label" do %>
            業態<%= tag.span "任意",
                  class: "badge rounded-pill text-bg-secondary store-contact-submission-field-badge" %>
          <% end %>
          <%= f.text_field :business_type,
                class: "form-control",
                maxlength: StoreContactSubmission::BUSINESS_TYPE_MAX_LENGTH,
                placeholder: "例: ガールズバー",
                autocomplete: "off" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, class: "form-label" do %>
            メールアドレス<%= tag.span "必須",
                  class: "badge rounded-pill text-bg-danger store-contact-submission-field-badge" %>
          <% end %>
          <%= f.email_field :email,
                class: "form-control",
                maxlength: StoreContactSubmission::EMAIL_MAX_LENGTH,
                placeholder: "例: owner@example.com",
                required: true,
                autocomplete: "email" %>
        </div>

        <div class="mb-3">
          <%= f.label :phone_number, class: "form-label" do %>
            電話番号<%= tag.span "必須",
                  class: "badge rounded-pill text-bg-danger store-contact-submission-field-badge" %>
          <% end %>
          <%= f.telephone_field :phone_number,
                class: "form-control",
                maxlength: StoreContactSubmission::PHONE_NUMBER_MAX_LENGTH,
                placeholder: "例: 090-1234-5678",
                required: true,
                autocomplete: "tel" %>
          <div class="form-text">ハイフンあり・なし、先頭0、全角入力でも送信できます。</div>
        </div>

        <div class="mb-3">
          <%= f.label :body, class: "form-label" do %>
            お問い合わせ内容<%= tag.span "任意",
                  class: "badge rounded-pill text-bg-secondary store-contact-submission-field-badge" %>
          <% end %>
          <%= f.text_area :body,
                class: "form-control",
                rows: 6,
                maxlength: StoreContactSubmission::BODY_MAX_LENGTH,
                placeholder: "例: 導入時期や料金について相談したいです。" %>
        </div>

        <div class="mb-4">
          <%= f.label :contactable_time, class: "form-label" do %>
            連絡可能時間帯<%= tag.span "任意",
                  class: "badge rounded-pill text-bg-secondary store-contact-submission-field-badge" %>
          <% end %>
          <%= f.text_field :contactable_time,
                class: "form-control",
                maxlength: StoreContactSubmission::CONTACTABLE_TIME_MAX_LENGTH,
                placeholder: "例: 平日 10:00〜18:00",
                autocomplete: "off" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "送信する", class: "btn btn-primary" %>
          <%= link_to "店舗向けLPへ戻る",
                @store_contact_back_path,
                class: "btn btn-outline-secondary",
                data: (@store_contact_back_path == stores_lp_202607_return_path ? { turbo_prefetch: false, turbo: false } : {}) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
