<% content_for :title, "店舗向けお問い合わせ" %>

<h1 class="container mt-4">店舗向けお問い合わせ</h1>

<div class="container mt-3" style="max-width: 720px;">
  <p class="text-secondary mb-4">
    Butterflyveの導入をご検討中の店舗様は、こちらからお気軽にお問い合わせください。
  </p>

  <% if @store_contact_submission.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @store_contact_submission.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <%= form_with model: @store_contact_submission,
            url: stores_contact_path,
            scope: :store_contact_submission do |f| %>
        <div class="mb-3">
          <%= f.label :name, "お名前（必須・#{StoreContactSubmission::NAME_MAX_LENGTH}文字以内）", class: "form-label" %>
          <%= f.text_field :name,
                class: "form-control",
                maxlength: StoreContactSubmission::NAME_MAX_LENGTH,
                placeholder: "例: 山田 太郎",
                required: true,
                autocomplete: "name" %>
        </div>

        <div class="mb-3">
          <%= f.label :store_name, "店舗名（必須・#{StoreContactSubmission::STORE_NAME_MAX_LENGTH}文字以内）", class: "form-label" %>
          <%= f.text_field :store_name,
                class: "form-control",
                maxlength: StoreContactSubmission::STORE_NAME_MAX_LENGTH,
                placeholder: "例: Butterflyve Bar 新宿店",
                required: true,
                autocomplete: "organization" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, "メールアドレス（必須・#{StoreContactSubmission::EMAIL_MAX_LENGTH}文字以内・メール形式）", class: "form-label" %>
          <%= f.email_field :email,
                class: "form-control",
                maxlength: StoreContactSubmission::EMAIL_MAX_LENGTH,
                placeholder: "例: owner@example.com",
                required: true,
                autocomplete: "email" %>
        </div>

        <div class="mb-3">
          <%= f.label :phone_number, "電話番号（必須・#{StoreContactSubmission::PHONE_NUMBER_MAX_LENGTH}文字以内）", class: "form-label" %>
          <%= f.telephone_field :phone_number,
                class: "form-control",
                maxlength: StoreContactSubmission::PHONE_NUMBER_MAX_LENGTH,
                placeholder: "例: 090-1234-5678",
                required: true,
                autocomplete: "tel" %>
          <div class="form-text">ハイフンあり・なし、先頭0、全角入力でも送信できます。</div>
        </div>

        <div class="mb-3">
          <%= f.label :body, "お問い合わせ内容（任意・#{number_with_delimiter(StoreContactSubmission::BODY_MAX_LENGTH)}文字以内）", class: "form-label" %>
          <%= f.text_area :body,
                class: "form-control",
                rows: 6,
                maxlength: StoreContactSubmission::BODY_MAX_LENGTH,
                placeholder: "例: 導入時期や料金について相談したいです。" %>
        </div>

        <div class="mb-4">
          <%= f.label :contactable_time, "連絡可能時間帯（任意・#{StoreContactSubmission::CONTACTABLE_TIME_MAX_LENGTH}文字以内）", class: "form-label" %>
          <%= f.text_field :contactable_time,
                class: "form-control",
                maxlength: StoreContactSubmission::CONTACTABLE_TIME_MAX_LENGTH,
                placeholder: "例: 平日 10:00〜18:00",
                autocomplete: "off" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "送信する", class: "btn btn-primary" %>
          <%= link_to "店舗向けLPへ戻る", stores_lp_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
