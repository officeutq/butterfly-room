<% content_for :title, "お問い合わせ" %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">お問い合わせ</h1>
    <div class="text-muted small">過去のお問い合わせと運営からの返信を確認できます。</div>
  </div>

  <%= link_to "新規お問い合わせ", new_support_inquiry_path, class: "btn btn-primary btn-lg" %>
</div>

<% if @support_inquiries.blank? %>
  <div class="alert alert-secondary">
    お問い合わせはまだありません。
  </div>
<% else %>
  <div class="referral-codes-list">
    <% @support_inquiries.each do |support_inquiry| %>
      <%= link_to support_inquiry_path(support_inquiry), class: "card referral-code-card text-decoration-none" do %>
        <div class="card-body">
          <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
            <div>
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge <%= support_inquiry.resolved? ? "text-bg-success" : "text-bg-primary" %>">
                  <%= support_inquiry.status_label %>
                </span>
                <span class="badge text-bg-secondary"><%= support_inquiry.category_label %></span>
              </div>
              <h2 class="h5 mb-0 text-break"><%= support_inquiry.subject %></h2>
            </div>
          </div>

          <div class="referral-code-row">
            <div class="referral-code-label">最終更新</div>
            <div class="referral-code-value text-muted small"><%= l(support_inquiry.last_message_at) %></div>
          </div>

          <div class="referral-code-row">
            <div class="referral-code-label">最終送信者</div>
            <div class="referral-code-value"><%= support_inquiry.last_message_sender_kind_label %></div>
          </div>

          <div class="referral-code-row">
            <div class="referral-code-label">作成日時</div>
            <div class="referral-code-value text-muted small"><%= l(support_inquiry.created_at) %></div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
