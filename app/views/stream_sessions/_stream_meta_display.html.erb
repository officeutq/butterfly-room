<% booth = stream_session.booth %>
<% user = stream_session.started_by_cast_user %>
<% title_display = stream_session.title.presence || booth.name %>
<% show_share_button = local_assigns.fetch(:show_share_button, false) %>

<div class="live-meta-row viewer-meta-row">
  <% if booth.live? || booth.away? %>
    <div class="meta-live-badge">
      <%= booth_status_badge(booth) %>
    </div>
  <% end %>

  <!-- avatar -->
  <div class="meta-avatar">
    <%= user_avatar_badge(user, size: 28) %>
  </div>

  <!-- name -->
  <div class="meta-name">
    <%= link_to display_name_or_anonymous(user),
          user_path(user),
          class: "text-decoration-none text-reset" %>
  </div>

  <!-- title -->
  <div class="meta-title text-truncate">
    <%= title_display %>
  </div>

  <% if show_share_button %>
    <button
      type="button"
      class="btn btn-primary d-inline-flex align-items-center gap-2 meta-share-button"
      data-controller="share"
      data-action="click->share#share"
      data-share-title="Butterflyve"
      data-share-text="Butterflyveのブースはこちら"
      data-share-url="<%= booth_url(booth) %>"
      aria-label="ブースを共有"
      title="ブースを共有">
      <i class="bi bi-share" aria-hidden="true"></i>
      <span>ブースを共有</span>
    </button>
  <% end %>

  <!-- viewer count -->
  <div class="meta-count">
    <i class="bi bi-people-fill" aria-hidden="true"></i>
    <span data-presence-poll-target="count">-</span>
  </div>
</div>
