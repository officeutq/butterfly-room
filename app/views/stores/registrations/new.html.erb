<h1 class="container mt-4">店舗として登録</h1>

<div class="container mt-3" style="max-width: 720px;">
  <% if @form.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @form.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <%= form_with model: @form,
            url: @store_registration_form_path,
            scope: :store_registration,
            data: lp_analytics_form_tracking_data(
              @lp_analytics_form_event_type,
              lp_identifier: @lp_analytics_form_lp_identifier
            ) do |f| %>
        <div class="mb-3">
          <%= f.label :store_name, "店舗名", class: "form-label" %>
          <%= f.text_field :store_name, class: "form-control", required: true, autocomplete: "organization" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, class: "form-control", required: true, autocomplete: "email" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, class: "form-control", required: true, autocomplete: "new-password" %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control", required: true, autocomplete: "new-password" %>
        </div>

        <div class="mb-3">
          <%= f.label :referral_code, "紹介コード", class: "form-label" %>
          <%= f.text_field :referral_code, class: "form-control", autocomplete: "off" %>
          <div class="form-text">お持ちの場合は入力してください。未入力の場合は標準コードで登録します。</div>
        </div>

        <p class="small text-secondary mb-3">
          登録することで、
          <%= link_to "利用規約", terms_path, target: "_blank", rel: "noopener" %>
          および
          <%= link_to "プライバシーポリシー", privacy_policy_path, target: "_blank", rel: "noopener" %>
          に同意したものとみなします。
        </p>

        <div class="d-flex gap-2">
          <%= f.submit "登録して管理画面へ", class: "btn btn-primary" %>
          <%= link_to "戻る",
                @store_registration_back_path,
                class: "btn btn-outline-secondary",
                data: ([ stores_lp_202607_return_path, stores_lp_202609_return_path ].include?(@store_registration_back_path) ? { turbo_prefetch: false, turbo: false } : {}) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
