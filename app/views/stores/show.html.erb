<div class="store-show">
  <%= render "stores/hero", store: @store %>

  <div class="container store-show-container">
    <div class="store-show-header d-flex justify-content-between align-items-start gap-3">
      <div class="min-w-0">
        <h1 class="store-show-title mb-0"><%= @store.name %></h1>
        <% if @can_edit_store %>
          <%= link_to edit_admin_store_path(@store, return_to: "store_detail"),
                class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2 mt-3 store-show-edit" do %>
            <i class="bi bi-pencil" aria-hidden="true"></i>
            <span>店舗情報を編集</span>
          <% end %>
        <% end %>
      </div>

      <div id="store_favorite_button" class="store-show-favorite">
        <%= render "favorites/stores/button_store_show", store: @store, favorited: @store_favorited %>
      </div>
    </div>

    <%= render "stores/basic_information", store: @store %>

    <h2 class="h5 mb-3"><%= @store.name %>のブース一覧</h2>

    <div class="store-show-booths">
      <% if @booths.blank? %>
        <div class="alert alert-warning mb-0" role="alert">
          公開中のブースがありません。
        </div>
      <% else %>
        <div class="row g-3">
          <% @booths.each do |booth| %>
            <div class="col-12 col-md-6 col-xl-4">
              <%= render "booths/card",
                    booth: booth,
                    booth_favorited: @favorite_booth_ids.include?(booth.id),
                    store_favorited: @store_favorited %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
