<div
  class="modal fade"
  id="<%= modal_id %>"
  tabindex="-1"
  aria-labelledby="<%= modal_id %>-label"
  <% if local_assigns[:refresh_url] %>
    data-controller="stream-share"
    data-stream-share-url-value="<%= refresh_url %>"
    data-action="show.bs.modal->stream-share#refresh hidden.bs.modal->stream-share#cancel turbo:before-cache@document->stream-share#cancel"
  <% end %>
  aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="<%= modal_id %>-label">共有先を選択</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>

      <div class="modal-body">
        <div data-stream-share-target="content">
          <%= render "cast/booths/share_content", share_text: share_text, share_url: share_url %>
        </div>
        <div hidden data-stream-share-target="error" role="alert">
          <p>共有情報を取得できませんでした。</p>
          <button type="button" class="btn btn-outline-secondary" data-action="stream-share#refresh">再確認</button>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          閉じる
        </button>
      </div>
    </div>
  </div>
</div>
