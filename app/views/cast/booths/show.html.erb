<% content_for :title, "ブース情報" %>
<% primary_cast = @booth.primary_cast_user %>
<% share_text = booth_web_share_text(primary_cast) %>
<% share_url = share_booth_url(@booth) %>

<div class="booth-show">
  <div class="booth-show-hero">
    <% if @booth.thumbnail_image.attached? %>
      <%= image_tag @booth.thumbnail_image,
            class: "booth-show-hero-image",
            alt: "#{@booth.name}のブース画像" %>
    <% else %>
      <div class="booth-show-hero-placeholder">
        <%= image_tag "no_image_logo.png", class: "no-image-logo", alt: "画像なし" %>
      </div>
    <% end %>
  </div>

  <div class="container booth-show-container">

    <div class="booth-show-header d-flex justify-content-between align-items-start gap-3">
      <div class="min-w-0">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h1 class="booth-show-title mb-0">
            <%= @booth.name.presence || "(no name)" %>
          </h1>

          <%= booth_status_badge(@booth) %>

          <% if @booth.archived? %>
            <span class="badge text-bg-dark">閉鎖済み</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="booth-show-info mt-3">
      <div class="booth-show-info-row">
        <div class="booth-show-info-label">キャスト</div>
        <div class="booth-show-info-value">
          <% if primary_cast.present? %>
            <%= link_to user_path(primary_cast), class: "text-decoration-none d-inline-flex align-items-center gap-2" do %>
              <%= user_avatar_badge(primary_cast, size: 28) %>
              <span><%= display_name_or_anonymous(primary_cast) %></span>
            <% end %>
          <% else %>
            <span class="text-muted">（未設定）</span>
          <% end %>
        </div>
      </div>

      <div class="booth-show-info-row">
        <div class="booth-show-info-label">所属店舗</div>
        <div class="booth-show-info-value">
          <%= link_to @booth.store.name, store_path(@booth.store) %>
        </div>
      </div>
    </div>

    <div class="booth-show-actions mt-4 d-flex gap-2 flex-wrap">
      <% unless @booth.archived? %>
        <button
          type="button"
          class="btn btn-primary d-inline-flex align-items-center gap-2"
          data-bs-toggle="modal"
          data-bs-target="#booth-share-modal"
          aria-haspopup="dialog"
          aria-controls="booth-share-modal">
          <i class="bi bi-share" aria-hidden="true"></i>
          <span>ブースを共有</span>
        </button>

        <%= link_to edit_cast_booth_path(@booth),
              data: { turbo_prefetch: false },
              class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
          <i class="bi bi-pencil-square" aria-hidden="true"></i>
          <span>編集</span>
        <% end %>
      <% end %>

      <%= link_to cast_booth_stream_sessions_path(@booth),
            data: { turbo_prefetch: false },
            class: "btn btn-outline-secondary d-inline-flex align-items-center gap-2" do %>
        <i class="bi bi-clock-history" aria-hidden="true"></i>
        <span>配信履歴</span>
      <% end %>
    </div>

    <% if @disconnect_status %>
      <div class="mt-3">
        <%= turbo_stream_from [@booth, :publisher_disconnect] %>
        <%= render "shared/publisher_disconnect_status",
              status: @disconnect_status,
              target_id: "publisher_disconnect_booth_#{@booth.id}",
              state_url: publisher_disconnect_state_cast_booth_path(@booth, scope: "booth") %>
      </div>
    <% end %>

    <% if current_user.at_least?(:store_admin) && Authorization::BoothPolicy.new(current_user, @booth).update? && !@booth.archived? %>
      <%= render "cast/booths/management_actions", booth: @booth %>
    <% end %>

    <div class="booth-show-description mt-4">
      <%= simple_format(@booth.description.presence || "-") %>
    </div>

  </div>
</div>

<% unless @booth.archived? %>
  <%= render "cast/booths/share_modal",
      modal_id: "booth-share-modal",
      share_text: share_text,
      share_url: share_url %>
<% end %>
