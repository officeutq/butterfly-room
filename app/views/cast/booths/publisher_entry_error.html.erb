<%= turbo_frame_tag request.headers["Turbo-Frame"].presence || "publisher-entry-error" do %>
  <div class="container py-4">
    <div class="alert alert-warning" role="alert"><%= @publisher_entry_error.message %></div>
    <% if @publisher_entry_error.code == "publisher_disconnect_pending" %>
      <% booth = @publisher_entry_error.booth %>
      <%= render "shared/publisher_disconnect_status",
            status: Ivs::RetryPublisherDisconnectsService.new(booth: booth, actor: current_user).state,
            target_id: "publisher_disconnect_booth_#{booth.id}", state_url: publisher_disconnect_state_cast_booth_path(booth) %>
    <% end %>
    <%= link_to "ダッシュボードへ", dashboard_path, class: "btn btn-outline-secondary mt-3", data: { turbo_frame: "_top" } %>
  </div>
<% end %>
