<% content_for :title, "ブース編集" %>

<%= form_with model: [:cast, @booth],
      html: { multipart: true },
      data: {
        controller: "image-pair-form",
        action: "submit->image-pair-form#submit"
      } do |f| %>
  <%= render "booths/form",
            f: f,
            booth: @booth,
            submit_label: "更新する",
            back_path: dashboard_path_for(current_user),
            cast_memberships: @cast_memberships,
            show_cast_assignment: current_user.at_least?(:store_admin) %>
<% end %>
