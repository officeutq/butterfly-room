<div class="mx-auto store-lp" style="max-width: 1040px;">
  <section class="py-4 py-md-5">
    <div class="row g-4 align-items-center">
      <div class="col-lg-6">
        <p class="text-primary fw-semibold small mb-2">店舗様向け</p>

        <h1 class="display-5 fw-bold mb-3">
          Butterflyve（バタフライブ）で、<br>
          来店しない日も既存客から売上をつくる。
        </h1>

        <p class="lead text-secondary mb-4">
          Butterflyveは、夜のお店のための遠隔営業ツールです。
          LINEなどで常連のお客様に配信URLを送り、オンライン上でドリンク売上をつくれます。
        </p>

        <div class="d-grid gap-2 d-sm-flex flex-wrap mb-3">
          <%= link_to "無料で店舗登録する",
                stores_new_registration_path(ref: lp_ref_code, from: "stores_lp"),
                class: "btn btn-primary btn-lg fw-bold" %>

          <%= link_to "お問い合わせはこちら",
                stores_contact_path(from: "stores_lp"),
                class: "btn btn-outline-primary btn-lg fw-bold" %>

          <%= link_to "トップへ戻る",
                root_path,
                class: "btn btn-outline-secondary btn-lg" %>
        </div>

        <p class="small text-secondary mb-0">
          初期費用0円・月額費用0円。売上が発生した分だけ手数料がかかります。
        </p>
      </div>

      <div class="col-lg-6">
        <div class="card bg-body-tertiary border-0 shadow-sm overflow-hidden">
          <%= image_tag "lp/store-hero.webp",
                class: "img-fluid",
                alt: "店舗がスマートフォンで配信URLを常連客に送るイメージ" %>
        </div>
      </div>
    </div>
  </section>

  <section class="py-4">
    <div class="mb-4">
      <p class="text-primary fw-semibold small mb-2">夜の店に配信が必要な理由</p>
      <h2 class="h3 fw-bold mb-0">
        来店だけに頼る売上、もったいなくないですか？
      </h2>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3">
      <div class="col">
        <div class="card h-100 bg-body-tertiary border-0">
          <div class="card-body p-4">
            <h3 class="h5 fw-bold">雨の日に弱い</h3>
            <p class="text-secondary mb-0">
              天候や曜日で来店が落ちる日でも、常連客とオンラインで接点を作れます。
            </p>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100 bg-body-tertiary border-0">
          <div class="card-body p-4">
            <h3 class="h5 fw-bold">遠隔がバラバラ</h3>
            <p class="text-secondary mb-0">
              個別連絡や振込ではなく、配信・ドリンク・売上確認をひとつにまとめられます。
            </p>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100 bg-body-tertiary border-0">
          <div class="card-body p-4">
            <h3 class="h5 fw-bold">新規集客が重い</h3>
            <p class="text-secondary mb-0">
              まずは既存のお客様にURLを送るだけ。新規集客より低いハードルで始められます。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-4 py-md-5">
    <div class="row g-4 align-items-center">
      <div class="col-lg-5">
        <%= image_tag "lp/remote-sales-flow.webp",
              class: "img-fluid rounded-4 shadow-sm",
              alt: "LINEでURLを送り、配信でドリンク売上が発生する流れ" %>
      </div>

      <div class="col-lg-7">
        <p class="text-primary fw-semibold small mb-2">使い方</p>
        <h2 class="h3 fw-bold mb-4">
          常連さんにURLを送るだけ。
        </h2>

        <div class="vstack gap-3">
          <div class="d-flex gap-3 align-items-start">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold flex-shrink-0 store-lp-step">1</div>
            <div>
              <h3 class="h6 fw-bold mb-1">お店・キャストが配信する</h3>
              <p class="text-secondary mb-0">空き時間や来店前後に、店舗のブースから配信できます。</p>
            </div>
          </div>

          <div class="d-flex gap-3 align-items-start">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold flex-shrink-0 store-lp-step">2</div>
            <div>
              <h3 class="h6 fw-bold mb-1">常連さんへURLを送る</h3>
              <p class="text-secondary mb-0">LINEやSNSで視聴ページを案内できます。</p>
            </div>
          </div>

          <div class="d-flex gap-3 align-items-start">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold flex-shrink-0 store-lp-step">3</div>
            <div>
              <h3 class="h6 fw-bold mb-1">お客様がドリンクで応援する</h3>
              <p class="text-secondary mb-0">視聴しながらコメントし、アプリ内ドリンクを送れます。</p>
            </div>
          </div>

          <div class="d-flex gap-3 align-items-start">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold flex-shrink-0 store-lp-step">4</div>
            <div>
              <h3 class="h6 fw-bold mb-1">消化して売上が確定する</h3>
              <p class="text-secondary mb-0">送られたドリンクは、キャストが消化して初めて売上になります。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-4">
    <div class="row g-4 align-items-center">
      <div class="col-lg-7">
        <p class="text-primary fw-semibold small mb-2">売上管理</p>
        <h2 class="h3 fw-bold mb-3">
          店舗単位で、<br>
          ドリンク売上として管理できます。
        </h2>

        <p class="text-secondary mb-4">
          お客様が送ったドリンクは未確定のまま保持され、キャストが消化した分だけ売上になります。
          未消化分や返却済みドリンクは売上に含めません。
        </p>

        <div class="row row-cols-1 row-cols-sm-3 g-3">
          <div class="col">
            <div class="p-3 rounded-3 border-primary-subtle bg-body-tertiary">
              <div class="fw-bold">ドリンク送信</div>
              <div class="small text-secondary">売上はまだ未確定</div>
            </div>
          </div>
          <div class="col">
            <div class="p-3 rounded-3 border-primary-subtle bg-body-tertiary">
              <div class="fw-bold">キャストが消化</div>
              <div class="small text-secondary">売上条件が成立</div>
            </div>
          </div>
          <div class="col">
            <div class="p-3 rounded-3 border-primary-subtle bg-body-tertiary">
              <div class="fw-bold">売上確定</div>
              <div class="small text-secondary">店舗で確認</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        <%= image_tag "lp/drink-consume-sales.webp",
              class: "img-fluid rounded-4 shadow-sm",
              alt: "ドリンク送信から消化、売上確定までの画面イメージ" %>
      </div>
    </div>
  </section>

  <section class="py-4 py-md-5">
    <p class="text-primary fw-semibold small mb-2">料金体系</p>
    <h2 class="h3 fw-bold mb-3">
      固定費なしで始められます。
    </h2>

    <div class="row row-cols-3 row-cols-md-3 g-1 text-center">
      <div class="col">
        <div class="card h-100 text-center bg-body-tertiary border-0">
          <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-center store-lp-price">
              <div class="display-6 fw-bold text-primary">0円</div>
            </div>
            <div class="fw-bold mt-2">初期費用</div>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100 text-center bg-body-tertiary border-0">
          <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-center store-lp-price">
              <div class="display-6 fw-bold text-primary">0円</div>
            </div>
            <div class="fw-bold mt-2">月額費用</div>
          </div>
        </div>
      </div>

      <div class="col">
        <div class="card h-100 text-center bg-body-tertiary border-0">
          <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-center store-lp-price">
              <div class="h2 fw-bold text-primary mb-0">
                売上時<br>のみ
              </div>
            </div>
            <div class="fw-bold mt-2">手数料</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-4">
    <div class="border-top pt-4 d-flex align-items-end justify-content-between gap-3 mb-3">
      <div>
        <p class="text-primary fw-semibold mb-2">How it works</p>
        <h2 class="h3 fw-bold mb-0">店舗運用に必要な機能をまとめて提供</h2>
      </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-3">
      <% [
        "lp/store_pr_01.jpg",
        "lp/store_pr_02.jpg",
        "lp/store_pr_03.jpg",
        "lp/store_pr_04.jpg",
        "lp/store_pr_05.jpg",
        "lp/store_pr_06.jpg"
      ].each do |image_path| %>
        <div class="col">
          <div class="rounded-4 border bg-body overflow-hidden">
            <%= image_tag image_path,
                  class: "img-fluid w-100 d-block",
                  alt: "" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="py-4">
    <div class="card border-primary-subtle bg-body-tertiary">
      <div class="card-body p-4 p-md-5 text-center">
        <p class="text-primary fw-semibold small mb-2">店舗様向け</p>

        <h2 class="h3 fw-bold mb-3">
          まずは店舗登録から始められます。
        </h2>

        <p class="text-secondary mb-4">
          固定費なしで、店舗の新しいオンライン導線を作れます。
        </p>

        <div class="d-grid gap-2 d-sm-flex justify-content-center">
          <%= link_to "無料で店舗登録する",
                stores_new_registration_path(ref: lp_ref_code, from: "stores_lp"),
                class: "btn btn-primary btn-lg fw-bold" %>

          <%= link_to "お問い合わせはこちら",
                stores_contact_path(from: "stores_lp"),
                class: "btn btn-outline-primary btn-lg fw-bold" %>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="border-top pt-4 d-flex flex-column flex-sm-row gap-2 justify-content-center align-items-center flex-wrap">
      <span class="text-secondary small">
        運営会社：
        <%= link_to "株式会社オフィスUTQ",
              "https://officeutq.co.jp",
              class: "link-secondary",
              target: "_blank",
              rel: "noopener" %>
      </span>

      <span class="text-secondary small d-none d-sm-inline">/</span>

      <%= link_to "特定商取引法に基づく表記",
            legal_path,
            class: "link-secondary small" %>

      <span class="text-secondary small d-none d-sm-inline">/</span>

      <%= link_to "資金決済法に基づく表示",
            payment_services_act_path,
            class: "link-secondary small" %>

      <span class="text-secondary small d-none d-sm-inline">/</span>

      <%= link_to "利用規約",
            terms_path,
            class: "link-secondary small" %>

      <span class="text-secondary small d-none d-sm-inline">/</span>

      <%= link_to "プライバシーポリシー",
            privacy_policy_path,
            class: "link-secondary small" %>
    </div>
  </section>
</div>
