<h1>ブース作成</h1>

<%= form_with model: @booth,
      url: admin_booths_path,
      scope: :booth,
      html: { multipart: true },
      data: {
        controller: "image-pair-form",
        action: "submit->image-pair-form#submit"
      } do |f| %>
  <%= render "booths/form",
            f: f,
            booth: @booth,
            submit_label: "作成する",
            back_path: dashboard_path_for(current_user),
            cast_memberships: @cast_memberships,
            show_cast_assignment: true %>
<% end %>
