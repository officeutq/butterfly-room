<div
  class="modal fade"
  tabindex="-1"
  aria-labelledby="store-ai-autofill-title"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  data-store-ai-autofill-target="modal">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2
          id="store-ai-autofill-title"
          class="modal-title fs-5"
          data-store-ai-autofill-target="title">
          AI店舗情報検索
        </h2>
        <button
          type="button"
          class="btn-close"
          aria-label="閉じる"
          data-store-ai-autofill-target="headerCloseButton"
          data-action="store-ai-autofill#close"></button>
      </div>

      <div class="modal-body" aria-live="polite" aria-busy="false" data-store-ai-autofill-target="body">
        <div class="text-center py-4" data-store-ai-autofill-target="loading">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">検索中</span>
          </div>
          <p class="mt-3 mb-0">AIで店舗情報を検索しています</p>
        </div>

        <p class="mb-3" data-store-ai-autofill-target="message"></p>
        <div data-store-ai-autofill-target="candidates"></div>

        <section class="mt-4" hidden data-store-ai-autofill-target="sourcesSection">
          <h3 class="fs-6">主要な情報源</h3>
          <ul class="mb-0" data-store-ai-autofill-target="sources"></ul>
        </section>
      </div>

      <div class="modal-footer">
        <button
          type="button"
          class="btn btn-outline-secondary"
          data-store-ai-autofill-target="closeButton"
          data-action="store-ai-autofill#close">
          閉じる
        </button>
        <button
          type="button"
          class="btn btn-primary"
          hidden
          data-store-ai-autofill-target="applyButton"
          data-action="store-ai-autofill#apply">
          フォームに反映する
        </button>
      </div>
    </div>
  </div>
</div>
