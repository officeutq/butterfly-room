<%# locals: f:, store:, submit_label:, back_path: %>

<div class="store-edit__action-bar">
  <div class="container store-edit__action-bar-inner">
    <%= link_to back_path,
          class: "btn btn-sm btn-link text-body text-decoration-none store-edit__back",
          data: {
            action: "store-edit#back",
            "store-edit-target": "backLink"
          } do %>
      <i class="bi bi-arrow-left" aria-hidden="true"></i>
      <span>戻る</span>
    <% end %>

    <%= f.submit submit_label,
          class: "btn btn-primary btn-sm rounded-pill px-3 store-edit__save",
          disabled: true,
          data: {
            "image-pair-form-target": "submitButton",
            "store-edit-target": "saveButton",
            turbo_confirm: "店舗情報と公開状態を更新します。よろしいですか？",
            turbo_submits_with: "保存中…",
            submitting_label: "保存中…"
          } %>
  </div>
</div>

<div class="store-edit__fields">
  <%= render "stores/information_fields", f: f, store: store %>

  <div class="mb-3">
    <div class="form-floating" data-bs-theme="light">
      <%= f.select :published,
            options_for_select([[ "公開", true ], [ "非公開", false ]], store.published?),
            {},
            class: "form-select" %>
      <%= f.label :published, "公開状態" %>
    </div>
    <div class="form-text">非公開の店舗と所属ブースは一般ユーザー向け画面に表示されません。</div>
  </div>
  <% if current_user.system_admin? %>
    <div class="mb-3">
      <div class="form-label">営業支援会社</div>
      <div class="form-check" data-bs-theme="light">
        <%= f.check_box :sales_support_company, class: "form-check-input" %>
        <%= f.label :sales_support_company,
              "この店舗を営業支援会社として扱う",
              class: "form-check-label" %>
      </div>
    </div>
  <% end %>

  <p class="alert alert-danger" role="alert" tabindex="-1" hidden
     data-image-pair-form-target="error"></p>

  <div class="store-edit__bottom-actions">
    <%= f.submit submit_label,
          class: "btn btn-primary btn-lg w-100 store-edit__bottom-save",
          disabled: true,
          data: {
            "image-pair-form-target": "submitButton",
            "store-edit-target": "saveButton",
            turbo_confirm: "店舗情報と公開状態を更新します。よろしいですか？",
            turbo_submits_with: "保存中…",
            submitting_label: "保存中…"
          } %>
  </div>
</div>
