<% content_for :head do %>
  <%= render "shared/filepond_head" %>
<% end %>

<% content_for :title, "店舗設定編集" %>

<div
  data-controller="store-ai-autofill"
  data-store-ai-autofill-url-value="<%= admin_store_ai_autofill_path(@store) %>">
  <div class="mb-3">
    <button
      type="button"
      class="btn btn-outline-primary"
      data-store-ai-autofill-target="searchButton"
      data-action="store-ai-autofill#search">
      AIで店舗情報を自動入力
    </button>
    <div class="form-text">現在入力中の店舗名で公開情報を検索し、選択した候補だけをフォームへ反映します。</div>
  </div>

  <%= form_with model: [:admin, @store] do |f| %>
    <%= render "form",
              f: f,
              store: @store,
              submit_label: "更新する",
              back_path: dashboard_path %>
  <% end %>

  <%= render "ai_autofill_modal" %>
</div>
