<% content_for :title, "店舗責任者を登録（代行用）" %>

<% if @form.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @form.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<p class="text-muted">対象店舗: <%= current_store.name %></p>

<%= form_with model: @form,
      url: admin_store_admin_proxy_registration_path,
      scope: :store_admin_proxy_registration do |form| %>
  <div class="mb-3">
    <%= form.label :display_name, "店舗責任者名", class: "form-label" %>
    <%= form.text_field :display_name, class: "form-control", required: true, autocomplete: "name" %>
  </div>

  <div class="mb-3">
    <%= form.label :email, "メールアドレス", class: "form-label" %>
    <%= form.email_field :email, class: "form-control", required: true, autocomplete: "email" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit "登録して案内メールを送信", class: "btn btn-primary" %>
    <%= link_to "戻る", admin_store_admin_invitations_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
