<% content_for :title, "初回店舗設定" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<% reviewing = @store.errors.any? %>

<%= form_with model: @store,
      url: admin_store_registration_setup_path(@store),
      method: :patch,
      id: "store-registration-setup-form",
      class: "store-edit store-registration-setup",
      html: { multipart: true },
      data: {
        controller: "store-registration-setup image-pair-form",
        "store-registration-setup-url-value": admin_store_ai_autofill_path(@store, registration_images: 1),
        "store-registration-setup-image-url-value": image_admin_store_registration_setup_path(@store),
        "store-registration-setup-ready-value": reviewing,
        "image-pair-form-always-submit-value": true,
        action: "submit->store-registration-setup#guardSubmit submit->image-pair-form#submit input->store-registration-setup#edited change->store-registration-setup#edited image-attachment-editor:change->store-registration-setup#imageChanged image-pair-form:submit-start->store-registration-setup#saving image-pair-form:submit-error->store-registration-setup#saveFailed"
      } do |f| %>
  <div class="store-registration-setup__loading" data-store-registration-setup-target="loading" role="status" tabindex="-1" hidden>
    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
    <span data-store-registration-setup-target="loadingMessage">お店の情報を探しています…</span>
  </div>

  <div class="store-edit__fields" data-store-registration-setup-target="content">
    <%= link_to dashboard_path, class: "store-edit__back btn btn-link text-body text-decoration-none px-0 mb-4" do %>
      <i class="bi bi-arrow-left" aria-hidden="true"></i> 戻る
    <% end %>

    <section data-store-registration-setup-target="intro" <%= "hidden" if reviewing %>>
      <div class="store-registration-setup__mark mb-3" aria-hidden="true"><i class="bi bi-shop"></i></div>
      <h1 class="h3 mb-3">お店の紹介ページを公開しましょう</h1>
      <p class="text-body-secondary">Butterflyveに店舗情報を掲載して、お客様にお店を知ってもらうきっかけをつくりましょう。</p>
      <h2 class="h5 mt-4">まずはAIで、店舗情報をかんたん入力</h2>
      <p class="text-body-secondary mb-4">店舗名からネット上の情報を探して、住所・営業時間・紹介文などの入力をお手伝いします。</p>
    </section>

    <header data-store-registration-setup-target="reviewHeader" <%= "hidden" unless reviewing %>>
      <h1 class="h4 mb-3" tabindex="-1" data-store-registration-setup-target="reviewHeading">店舗情報を確認しましょう</h1>
      <p class="text-body-secondary" data-store-registration-setup-target="resultMessage" role="status" hidden></p>
      <p class="form-text mb-4">任意項目は空欄のままでも公開できます。あとから追加・変更することもできます。</p>
    </header>

    <div class="form-floating mb-3" data-bs-theme="light">
      <%= f.text_field :name, class: "form-control", placeholder: "店舗名", required: true,
            data: { "store-registration-setup-target": "name" } %>
      <%= f.label :name, "店舗名（必須）" %>
    </div>
    <p class="text-danger small" role="alert" data-store-registration-setup-target="nameError" hidden></p>

    <div data-store-registration-setup-target="initialAction" <%= "hidden" if reviewing %>>
      <button type="button" class="btn btn-primary btn-lg w-100 py-3" data-action="store-registration-setup#search">
        <i class="bi bi-stars me-1" aria-hidden="true"></i> AIで店舗情報を自動入力
      </button>
      <p class="small text-body-secondary mt-3 mb-0">見つかった情報は、あとで確認・修正できます。<br>この操作だけで店舗が公開されることはありません。</p>
    </div>

    <fieldset class="border-0 p-0 m-0 w-100" data-store-registration-setup-target="details" <%= "hidden disabled" unless reviewing %>>
      <legend class="visually-hidden">店舗の詳細情報</legend>
      <button type="button" class="btn btn-outline-secondary btn-sm mb-4" data-action="store-registration-setup#search">
        <i class="bi bi-stars me-1" aria-hidden="true"></i> AIで再検索
      </button>

      <% if @store.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <ul class="mb-0">
            <% @store.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= render "stores/information_fields", f:, store: @store, registration_setup: true %>

      <details class="store-registration-setup__sources mb-4" data-store-registration-setup-target="sourcesSection" hidden>
        <summary>AIが参照した情報</summary>
        <ul class="small mt-2 mb-0" data-store-registration-setup-target="sources"></ul>
      </details>

      <p class="form-text mt-4 mb-2">入力内容は公開後も変更できます。</p>
      <p class="alert alert-danger" role="alert" tabindex="-1" hidden data-image-pair-form-target="error"></p>
      <%= f.submit "店舗情報を保存して公開する",
            class: "btn btn-primary btn-lg w-100 store-edit__bottom-save",
            data: { "image-pair-form-target": "submitButton", submitting_label: "保存中…" } %>
    </fieldset>
  </div>
<% end %>
