<% content_for :title, "プロフィール編集" %>

<%= form_with model: @user,
      url: profile_path,
      id: "profile-edit-form",
      class: "profile-edit",
      html: { multipart: true },
      data: {
        controller: "image-pair-form profile-edit",
        action: [
          "submit->image-pair-form#submit",
          "submit->profile-edit#prepareSubmit",
          "input->profile-edit#refresh",
          "change->profile-edit#refresh",
          "image-attachment-editor:change->profile-edit#refresh",
          "image-pair-form:submit-start->profile-edit#imageSubmitStarted",
          "image-pair-form:submit-error->profile-edit#imageSubmitFailed",
          "turbo:submit-end->profile-edit#turboSubmitEnd"
        ].join(" ")
      } do |f| %>
  <div class="profile-edit__action-bar">
    <div class="container profile-edit__action-bar-inner">
      <%= link_to dashboard_path,
            class: "btn btn-sm btn-link text-body text-decoration-none profile-edit__back",
            data: {
              action: "profile-edit#back",
              "profile-edit-target": "backLink"
            } do %>
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>戻る</span>
      <% end %>

      <%= f.submit "保存",
            class: "btn btn-primary btn-sm rounded-pill px-3 profile-edit__save",
            disabled: true,
            data: {
              "image-pair-form-target": "submitButton",
              "profile-edit-target": "saveButton",
              turbo_submits_with: "保存中…",
              submitting_label: "保存中…"
            } %>
    </div>
  </div>

  <div class="profile-edit__media" aria-label="プロフィール画像">
    <%= render "shared/integrated_image_attachment_editor",
          **image_attachment_editor_state(@user, :cover),
          param_root: :cover_image_pair,
          ratio_key: :social,
          presentation: :cover,
          label: "カバー画像" %>

    <%= render "shared/integrated_image_attachment_editor",
          **image_attachment_editor_state(@user, :avatar),
          param_root: :avatar_image_pair,
          ratio_key: :square,
          presentation: :avatar,
          label: "アバター画像" %>
  </div>

  <div class="profile-edit__fields">
    <div class="mb-3">
      <div class="form-floating" data-bs-theme="light">
        <%= f.text_field :display_name,
              class: "form-control",
              placeholder: "表示名",
              data: { "profile-edit-target": "displayName" } %>
        <%= f.label :display_name, "表示名" %>
      </div>
      <div class="form-text">未入力の場合は「ななしさん」と表示されます。</div>
    </div>

    <div class="mb-3">
      <div class="form-floating" data-bs-theme="light">
        <%= f.text_area :bio,
              class: "form-control profile-edit__bio",
              placeholder: "自己紹介",
              maxlength: 500,
              data: { "profile-edit-target": "bio" } %>
        <%= f.label :bio, "自己紹介" %>
      </div>
      <div class="form-text">最大500文字</div>
    </div>
  </div>

  <p class="alert alert-danger" role="alert" tabindex="-1" hidden
     data-image-pair-form-target="error"></p>

  <section class="card profile-edit__account mb-3" aria-labelledby="profile-account-heading">
    <div class="card-body">
      <h2 id="profile-account-heading" class="h6">アカウント</h2>
      <div class="small text-body-secondary mb-2">メールアドレス</div>
      <div class="text-break mb-3"><%= @user.email %></div>
      <%= link_to "メールアドレスを変更",
            edit_email_change_path,
            class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </section>

  <% unless current_user.system_admin? %>
    <div class="profile-edit__withdrawal text-center">
      <%= link_to "退会する",
            account_withdrawal_path,
            data: { turbo_frame: "modal" },
            class: "btn btn-link btn-sm text-danger text-decoration-none" %>
    </div>
  <% end %>

  <div class="profile-edit__bottom-actions">
    <%= f.submit "保存",
          class: "btn btn-primary btn-lg w-100 profile-edit__bottom-save",
          disabled: true,
          data: {
            "image-pair-form-target": "submitButton",
            "profile-edit-target": "saveButton",
            turbo_submits_with: "保存中…",
            submitting_label: "保存中…"
          } %>
  </div>
<% end %>
