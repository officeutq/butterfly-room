<% content_for :title, "プロフィール編集" %>

<div class="card mb-3">
  <div class="card-body">
    <div class="form-label mb-1">メールアドレス</div>
    <div class="mb-3"><%= @user.email %></div>

    <%= link_to "メールアドレスを変更",
          edit_email_change_path,
          class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<%= form_with model: @user,
      url: profile_path,
      html: { multipart: true },
      data: {
        controller: "image-pair-form",
        action: "submit->image-pair-form#submit"
      } do |f| %>
  <div class="mb-3">
    <%= f.label :display_name, "表示名", class: "form-label" %>
    <%= f.text_field :display_name, class: "form-control" %>
    <div class="form-text">未入力の場合は email が表示されます（将来変更の可能性あり）</div>
  </div>

  <div class="mb-3">
    <%= f.label :bio, "自己紹介（bio）", class: "form-label" %>
    <%= f.text_area :bio, class: "form-control", rows: 6 %>
    <div class="form-text">最大500文字</div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <%= render "shared/image_attachment_editor",
            **image_attachment_editor_state(@user, :avatar),
            param_root: :avatar_image_pair,
            ratio_key: :square,
            label: "アバター画像" %>
      <p class="form-text mb-0">小型アイコンなどに使われる正方形の画像です。</p>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <%= render "shared/image_attachment_editor",
            **image_attachment_editor_state(@user, :cover),
            param_root: :cover_image_pair,
            ratio_key: :social,
            label: "カバー画像" %>
      <p class="form-text mb-0">ユーザーカードやプロフィール上部に使う1200×630の画像です。</p>
    </div>
  </div>

  <p class="alert alert-danger" role="alert" tabindex="-1" hidden data-image-pair-form-target="error"></p>

  <div class="d-flex gap-2">
    <%= f.submit "更新する",
          class: "btn btn-primary",
          data: {
            "image-pair-form-target": "submitButton",
            turbo_submits_with: "保存中…"
          } %>
    <%= link_to "戻る", dashboard_path, class: "btn btn-outline-secondary" %>

    <% unless current_user.system_admin? %>
      <%= link_to "退会する",
            account_withdrawal_path,
            data: { turbo_frame: "modal" },
            class: "btn btn-link btn-sm text-danger text-decoration-none align-self-center" %>
    <% end %>
  </div>
<% end %>
