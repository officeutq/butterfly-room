{
  "scripts": {
    "copy:bi": "node -e \"const fs=require('fs');const path=require('path');const dest='app/assets/builds/bootstrap-icons';fs.mkdirSync(path.join(dest,'fonts'),{recursive:true});fs.copyFileSync('node_modules/bootstrap-icons/font/bootstrap-icons.css',path.join(dest,'bootstrap-icons.css'));for(const file of fs.readdirSync('node_modules/bootstrap-icons/font/fonts')){fs.copyFileSync(path.join('node_modules/bootstrap-icons/font/fonts',file),path.join(dest,'fonts',file));}\"",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css ./app/assets/stylesheets/store_lp_202607.scss:./app/assets/builds/store_lp_202607.css ./app/assets/stylesheets/store_lp_202609.scss:./app/assets/builds/store_lp_202609.css --no-source-map --load-path=node_modules && npm run copy:bi",
    "watch:css": "npm run copy:bi && sass --watch ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css ./app/assets/stylesheets/store_lp_202607.scss:./app/assets/builds/store_lp_202607.css ./app/assets/stylesheets/store_lp_202609.scss:./app/assets/builds/store_lp_202609.css --load-path=node_modules",
    "test:js": "node --test test/javascript/*.cjs",
    "manual:capture:install": "playwright install chromium",
    "manual:capture:smoke": "playwright test --config=playwright.config.js --project=chromium tests/manual_capture/smoke.spec.js",
    "manual:capture:accounts": "playwright test --config=playwright.config.js --project=chromium tests/manual_capture/account_creation.spec.js",
    "manual:capture:store_admin": "playwright test --config=playwright.config.js --project=chromium tests/manual_capture/store_admin.spec.js",
    "manual:capture:cast": "playwright test --config=playwright.config.js --project=chromium tests/manual_capture/cast.spec.js",
    "manual:capture:customer": "playwright test --config=playwright.config.js --project=chromium tests/manual_capture/customer.spec.js",
    "manual:capture:system_admin": "playwright test --config=playwright.config.js --project=chromium tests/manual_capture/system_admin.spec.js"
  },
  "dependencies": {
    "@banuba/webar": "^1.18.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.11.3",
    "cropperjs": "^2.2.0",
    "deepar": "^5.6.21",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-preview": "^4.6.12",
    "filepond-plugin-image-resize": "^2.0.10",
    "filepond-plugin-image-transform": "^3.8.7",
    "heic-to": "1.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "sass": "^1.97.2"
  }
}
