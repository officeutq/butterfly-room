# Copy this file to .env.staging on the staging EC2 host and replace placeholders.
APP_ENV=staging
RAILS_ENV=production
APP_HOST=staging.butterflyve.jp
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=2
JOB_CONCURRENCY=1

DATABASE_URL=
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=butterfly-room-staging

# LP analytics Google Sheets export settings.
# Keep automatic export disabled; use the explicit Rake task for staging verification.
LP_ANALYTICS_SHEETS_EXPORT_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=daily_raw
GOOGLE_SHEETS_CREDENTIALS_SECRET_ID=

SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
MAILER_SENDER=no-reply@butterflyve.jp
MAIL_DELIVERY_ENABLED=true
MAIL_DELIVERY_MODE=redirect
MAIL_ALLOWED_RECIPIENTS=
MAIL_REDIRECT_RECIPIENT=
MAIL_SUBJECT_PREFIX=[STAGING]

SMS_DELIVERY_MODE=mock
SMS_ALLOWED_TEST_NUMBERS=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

IVS_STAGE_ENV=staging
IVS_STAGE_NAME_PREFIX=br-staging

GTM_ENABLED=false
GTM_CONTAINER_ID=

BASIC_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

BEAUTY_PROVIDER=banuba
BANUBA_CLIENT_TOKEN=
DEEPAR_LICENSE_KEY=
GOOGLE_MAPS_API_KEY=
