instance_type                = "t3.micro"
root_volume_size_gib         = 20
ssh_allowed_cidrs            = []
https_listener_rule_priority = 10
http_listener_rule_priority  = 10

# Set this in the Git-ignored terraform.tfvars to the existing staging Secret name.
# Do not put the service account JSON or any secret value in Terraform variables.
google_sheets_credentials_secret_name = "replace-with-existing-staging-secret-name"
